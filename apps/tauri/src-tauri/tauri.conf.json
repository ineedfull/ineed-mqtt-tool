{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ineed MQTT Tool",
  "version": "0.1.0",
  "identifier": "com.ineedfull.mqtt-tool",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "backgroundThrottling": "disabled",
        "title": "iNeed MQTT Tool",
        "width": 1360,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "MQTT development and debugging assistant",
    "publisher": "Ineed",
    "homepage": "https://www.ineedfull.com/",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "Ineed",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional"
      }
    }
  }
}
